<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
     <form class="w-50 mx-auto px-3 py-3" action="/updatetodo/<%= onetodo._id %>" method="post">
        <h3 class="text-center ">Edit Todo</h3>
        <input value="<%= onetodo.title %>" name="title" class="form-control mb-3" type="text" placeholder="Title">
        <input value="<%= onetodo.description %>" name="description" class="form-control mb-3" type="text" placeholder="Description">
        <button class="btn btn-dark">Update</button>
    </form>

</body>
</html>