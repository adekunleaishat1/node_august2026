<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <title>Document</title>
</head>
<body>
    <h1>Welcome to your dashboard <%= username %></h1>

    <form class="w-50 mx-auto px-3 py-3" action="/addtodo/<%= username %>" method="post">
        <h3 class="text-center ">Todo list</h3>
        <input name="title" class="form-control mb-3" type="text" placeholder="Title">
        <input name="description" class="form-control mb-3" type="text" placeholder="Description">
        <button class="btn btn-dark">Addtodo</button>
    </form>



    <% if (username == "tholai") { %>
        <p>Na woman you be </p>
    <% } else {%>
       <p>Na man you be </p>
    <% }  %>
       
<% alltodo.forEach((element ,index)=> { %>
    <p><%= index + 1 %></p>
    <p><%= element.title %></p>
    <p><%= element.description %></p>

   <form action="/updatetodo/<%= element._id %>" method="post">
    <input value=<%= element.completed %> name="completed" type="text" hidden>
     <input type="checkbox"  onchange="this.form.submit()" <%= element.completed && "checked" %> >
   </form>

    <form action="/deletetodo/<%= element._id  %>" method="post">
       <button>delete</button>
    </form> 
    
<% }) %>

</body>
</html>